{
  "name": "@evanpatchouli/scheduler",
  "version": "2.1.0",
  "description": "A package help to manage the transcations scheduled in node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "index.js"],
  "dependencies": {
    "@types/node": "^16.17.1",
    "@types/node-schedule": "^2.1.0",
    "cron-parser": "^4.8.1",
    "js-text-chart": "^1.0.9",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "redis": "4.7.1",
    "typescript": "^4.9.5"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run tsc:build && node --test test/regression.test.js test/redis-codec.test.js && npm run test:types",
    "test:redis": "npm run tsc:build && node --test test/redis-integration.test.js",
    "test:types": "tsc -p test/consumer",
    "test:package": "node test/package-smoke.js",
    "prepack": "npm run tsc:build",
    "serve": "node ./test/server.js",
    "tsc:build": "tsc --outDir dist"
